# Copy to .env.local for Next.js (never commit real secrets).

# Demo mode works without Supabase/Stripe — set false for paid beta.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@jokohub.app

# Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode (scaffold — paste test keys when ready)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_SEAT=price_...

# Optional
NEXT_PUBLIC_PRODUCT_NAME=JokoHub
